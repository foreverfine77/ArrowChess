{
  "name": "jianqi",
  "private": true,
  "workspaces": ["core"],
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "dev": "vite web --port 5174 --strictPort",
    "build:web": "node scripts/build-web.mjs",
    "build:minigame": "node scripts/build-minigame.mjs",
    "test": "node scripts/check-local-minigame.mjs build && vitest run && node --test scripts/sync-core.test.mjs && node scripts/check-local-minigame.mjs test",
    "test:sync": "node --test scripts/sync-core.test.mjs",
    "test:minigame": "npm run build:minigame && node --test scripts/test-minigame-build.test.mjs",
    "test:renderer": "vitest run web/tests/renderer.test.ts",
    "test:minigame-logic": "vitest run web/tests/minigame-touch.test.ts",
    "test:session": "node --test scripts/minigame-session.test.mjs",
    "test:cloud": "node scripts/build-minigame.mjs && node --test scripts/cloud-functions.test.mjs",
    "benchmark:ai": "node scripts/benchmark-ai.mjs",
    "typecheck": "tsc -p core/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && node scripts/check-local-minigame.mjs typecheck",
    "typecheck:miniprogram": "tsc -p miniprogram/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "1.6.1"
  }
}
